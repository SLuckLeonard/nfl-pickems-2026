rules_version = '2';

// NFL Pick'em 2026 — Firestore security rules.
//
// This is a private two-player app. Every visitor gets an anonymous Firebase
// auth session (see src/hooks/useAuthReady.js), so requiring `request.auth`
// keeps the database off the open internet while letting both players read and
// write the shared game state (picks, results, season config, players).
//
// Deploy: paste into Firebase console (Firestore → Rules → Publish), or run
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
